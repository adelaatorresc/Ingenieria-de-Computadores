{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with study streak, level and achievement badges",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "studentId": { "type": "string" },
        "selectedCourseId": { "type": "string" },
        "avatarColor": { "type": "string" },
        "createdAt": { "type": "string" },
        "currentStreak": { "type": "number" },
        "lastActiveDate": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "unlockedBadgeIds": { "type": "array" }
      },
      "required": ["id", "email", "name"]
    },
    "UserStudyData": {
      "title": "UserStudyData",
      "description": "User synchronized study progress, times, completed exercises, grades, exams and plans across devices",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "exerciseTimes": { "type": "object" },
        "completedExercises": { "type": "object" },
        "grades": { "type": "array" },
        "exams": { "type": "array" },
        "plans": { "type": "array" },
        "customCourses": { "type": "array" },
        "lastUpdated": { "type": "string" }
      },
      "required": ["userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile, streak, level and achievements"
    },
    "/users/{userId}/studyData/{dataDocId}": {
      "schema": "UserStudyData",
      "description": "Cross-device synced study data for user"
    }
  }
}
